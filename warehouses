// Feature Geometry
//// Level 1 admin boundaries 
var gaul = ee.FeatureCollection("FAO/GAUL_SIMPLIFIED_500m/2015/level1")
//// CA boundary
var caGeom = ee.Feature(gaul.filter(ee.Filter.eq('ADM1_NAME','California')).first())
  .geometry()
  
// Image Collections
//// 1999: agg birth year
//// using raw scenes because T1_L2 will not work with simpleComposite
var landsat1999 = ee.ImageCollection("LANDSAT/LE07/C02/T1")
  .filterBounds(caGeom)
  .filterDate('1999-05-29','1999-12-31')
var composite1999 = ee.Algorithms.Landsat.simpleComposite({
  collection:landsat1999,
  asFloat:true
})
var rgbVisL7 = {bands:['B3', 'B2', 'B1'], min:0, max:0.3}
//// 2020: after significant anthropogenic land change
//// removal of orange groves; construction of warehousing
var landsat2019 = ee.ImageCollection("LANDSAT/LC08/C02/T1")
  .filterBounds(caGeom)
  .filterDate('2019-05-29','2019-12-31')
var composite2019 = ee.Algorithms.Landsat.simpleComposite({
  collection:landsat2019,
  asFloat:true
})
var rgbVisL8 = {bands:['B4', 'B3', 'B2'], min:0, max:0.3}

